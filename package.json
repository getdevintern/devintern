{
  "name": "devintern",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for @devintern/code and @devintern/pm.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!@getdevintern/code",
    "format": "turbo run format && bun run format:examples",
    "format:check": "turbo run format:check && bun run format:check:examples",
    "format:examples": "oxfmt \"examples/pipeline-plugins/**/*.ts\"",
    "format:check:examples": "oxfmt --check \"examples/pipeline-plugins/**/*.ts\"",
    "lint": "turbo run lint && bun run lint:examples",
    "lint:examples": "oxlint examples/pipeline-plugins",
    "prepare": "lefthook install",
    "typecheck": "turbo run typecheck && bun run typecheck:examples",
    "typecheck:examples": "tsc --noEmit -p examples/pipeline-plugins",
    "test": "turbo run test && bun run test:examples",
    "test:examples": "bun run examples/pipeline-plugins/run-tests.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "lefthook": "^2.1.5",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "turbo": "^2.10.11",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4"
  },
  "trustedDependencies": [
    "electron"
  ]
}

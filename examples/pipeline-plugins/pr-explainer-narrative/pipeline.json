{
  "artifacts": {
    "publish": {
      "destination": "pr-comment",
      "select": [{ "key": "explanation-narrative", "presentation": "inline" }]
    }
  },
  "plugins": ["./steps/pr-explainer-narrative.ts"],
  "steps": [
    { "use": "implement" },
    { "use": "commit" },
    { "use": "verify", "onFail": "loopback" },
    { "use": "auto-review" },
    {
      "use": "pr-explainer-narrative",
      "promptFile": "/home/you/.devintern/pipelines/prompts/pr-explainer-narrative.md",
      "outputName": "pr-explanation.md"
    },
    { "use": "finalize" }
  ]
}

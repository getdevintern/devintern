{
  "plugins": ["./steps/agent-review.ts"],
  "steps": [
    { "use": "implement" },
    { "use": "commit" },
    {
      "use": "agent-review",
      "promptFile": "./prompts/agent-review.md",
      "minPriority": "medium",
      "maxIterations": 2,
      "onBlocked": "loopback"
    },
    { "use": "finalize" }
  ]
}

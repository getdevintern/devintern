{
  "pipeline": {
    "plugins": ["./.devintern-code/steps/check-policy.ts"],
    "steps": [
      { "use": "implement" },
      { "use": "commit" },
      {
        "use": "check-policy",
        "forbiddenPaths": ["secrets/", "credentials/", ".env"],
        "onFail": "halt"
      },
      { "use": "finalize" }
    ]
  }
}

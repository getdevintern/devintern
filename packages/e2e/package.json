{
  "name": "@devintern/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test tests/local",
    "test:trackers": "bun run scripts/trackers.ts",
    "test:e2e": "bun run scripts/github.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test:e2e:github": "bun run scripts/github.ts",
    "test:e2e:gitlab": "bun run scripts/gitlab.ts",
    "test:e2e:gitlab-relay": "bun run scripts/gitlab-relay.ts",
    "gitlab:up": "bun run scripts/gitlab-local.ts up",
    "gitlab:down": "bun run scripts/gitlab-local.ts down",
    "gitlab:status": "bun run scripts/gitlab-local.ts status",
    "test:e2e:bitbucket": "bun run scripts/hosted.ts bitbucket",
    "test:e2e:gitlab-com": "bun run scripts/hosted.ts gitlab-com",
    "test:e2e:tracker": "bun run scripts/tracker.ts",
    "test:e2e:tracker:gitlab": "bun run scripts/tracker-gitlab.ts",
    "test:e2e:tracker:gitlab-com": "bun run scripts/tracker-gitlab-com.ts"
  },
  "dependencies": {
    "@devintern/agent-harness": "workspace:*"
  }
}

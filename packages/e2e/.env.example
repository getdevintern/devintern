# Copy to .env.local in this directory (ignored by Git).
# Dedicated repositories must already have an initial/default branch.
E2E_BITBUCKET_REPOSITORY=workspace/devintern-e2e
# Bearer repository/workspace/OAuth access token; not an email-based API token.
E2E_BITBUCKET_TOKEN=
E2E_GITLAB_COM_PROJECT=group/devintern-e2e
# Personal/project access token with api scope and Git repository write access.
E2E_GITLAB_COM_TOKEN=

# Remote tracker suites (opt-in; ordinary `test` never runs them).
# GitHub Issues: existing repository that hosts the scenario tickets and is
# also the code host; never created or deleted. The token needs issues
# read/write plus repository contents and pull-request write.
E2E_TRACKER_REPOSITORY=owner/devintern-e2e-tracker
E2E_TRACKER_TOKEN=
# Optional extra comma-separated status labels for per-project transitions.
# The scenario creates its own three exclusive labels; these are additive.
E2E_TRACKER_STATUS_LABELS=
# Local GitLab Issues: run `test:e2e:tracker:gitlab` against the local instance
# (see gitlab:up). It uses the generated .local/gitlab.json credentials, or
# E2E_GITLAB_URL/E2E_GITLAB_TOKEN as above, plus the GitHub code-host variables
# (E2E_GITHUB_REPOSITORY/E2E_GITHUB_TOKEN or a local `gh auth login`).
#
# GitLab.com Issues: run `test:e2e:tracker:gitlab-com` against the hosted
# E2E_GITLAB_COM_PROJECT above when it has Issues enabled. The project is never
# deleted; scenario issues are closed in cleanup.


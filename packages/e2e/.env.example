# Copy to .env.local in this directory (ignored by Git).
# Dedicated repositories must already have an initial/default branch.
E2E_BITBUCKET_REPOSITORY=workspace/devintern-e2e
# Bearer repository/workspace/OAuth access token; not an email-based API token.
E2E_BITBUCKET_TOKEN=
E2E_GITLAB_COM_PROJECT=group/devintern-e2e
# Personal/project access token with api scope and Git repository write access.
E2E_GITLAB_COM_TOKEN=

{
  "name": "@getdevintern/pm",
  "version": "2.2.2",
  "description": "Turn rough notes, logs, and Figma into codebase-grounded tracker tickets with any coding agent. Self-hosted, BYOK.",
  "type": "module",
  "bin": {
    "devpm": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./engine": "./lib/engine/index.ts",
    "./issue-types": "./lib/issue-types.ts",
    "./package.json": "./package.json",
    "./config": "./lib/config.ts",
    "./init": "./lib/init-wizard.ts",
    "./init-shared": "./lib/init-shared.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "lib",
    "prompts",
    "README.md",
    "LICENSE.md",
    ".env.example"
  ],
  "scripts": {
    "build": "bun build index.ts --target=node --outdir=dist --format=esm --external=ink --external=react --external=ink-scroll-view --minify && bun run tsc --noEmit",
    "format": "oxfmt \"index.ts\" \"lib/**/*.ts\" \"lib/**/*.tsx\" \"*.test.ts\"",
    "format:check": "oxfmt --check \"index.ts\" \"lib/**/*.ts\" \"lib/**/*.tsx\" \"*.test.ts\"",
    "lint": "oxlint .",
    "install-global": "bun run build && bun link",
    "uninstall-global": "bun unlink",
    "prepublishOnly": "bun run build",
    "typecheck": "bun run tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "agent",
    "cli",
    "self-hosted",
    "byok",
    "jira",
    "linear",
    "github",
    "trello",
    "asana",
    "azure-devops",
    "figma",
    "claude",
    "claude-code",
    "opencode",
    "codex",
    "cursor",
    "project-management",
    "task-management",
    "story-writing",
    "devtools",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdevintern/devintern.git",
    "directory": "packages/pm"
  },
  "bugs": {
    "url": "https://github.com/getdevintern/devintern/issues"
  },
  "homepage": "https://devintern.com",
  "author": "Daniil",
  "license": "SEE LICENSE IN LICENSE.md",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@devintern/agent-harness": "workspace:*",
    "@devintern/task-trackers": "workspace:*",
    "@devintern/text-formatter": "workspace:*",
    "@devintern/utils": "workspace:*",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/react": "^19.2.7",
    "ink": "^6.6.0",
    "ink-scroll-view": "^0.3.2",
    "ink-text-input": "^6.0.0",
    "react": "19.2.5"
  }
}

# Copied to .env for local/dev builds. Baked into the main process at build time
# via electron.vite.config.ts. Missing key → analytics no-ops.
# Shell / CI env overrides these values when set.
POSTHOG_API_KEY=
# Optional; defaults to https://us.i.posthog.com
# POSTHOG_HOST=https://us.i.posthog.com

# GitHub App (DevIntern PM) Client ID for the OAuth device flow used by Connect.
# Public value — safe to bake into the bundle. Get it from the App's settings page
# (Settings → Developer settings → GitHub Apps → DevIntern PM → General → Client ID).
GITHUB_OAUTH_CLIENT_ID=

# Sentry error tracking (main-process crashes and unhandled errors). Baked into
# the main process at build time; missing DSN → error tracking no-ops. Users can
# opt out via Settings (shares the analytics toggle).
SENTRY_DSN=

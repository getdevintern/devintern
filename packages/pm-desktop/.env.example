# Copied to .env for local/dev builds. Baked into the main process at build time
# via electron.vite.config.ts. Missing key → analytics no-ops.
# Shell / CI env overrides these values when set.
POSTHOG_API_KEY=
# Optional; defaults to https://us.i.posthog.com
# POSTHOG_HOST=https://us.i.posthog.com

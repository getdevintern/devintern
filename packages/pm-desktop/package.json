{
  "name": "@devintern/pm-desktop",
  "productName": "DevIntern PM",
  "version": "0.9.9",
  "private": true,
  "description": "Desktop app for @devintern/pm — multi-ticket AI task creation for your tracker.",
  "author": "DevIntern <hello@getdevintern.com>",
  "homepage": "https://getdevintern.com",
  "desktopName": "com.getdevintern.pm-desktop.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/getdevintern/devintern.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build && bun run tsc --noEmit",
    "package": "bun run scripts/package.ts",
    "package:dir": "bun run scripts/package.ts --dir",
    "package:linux": "bun run scripts/package.ts --linux",
    "package:mac": "bun run scripts/package.ts --mac",
    "format": "oxfmt \"src/**/*.ts\" \"src/**/*.tsx\" \"scripts/**/*.ts\" \"build/**/*.{ts,cjs}\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"src/**/*.tsx\" \"scripts/**/*.ts\" \"build/**/*.{ts,cjs}\"",
    "lint": "oxlint .",
    "typecheck": "bun run tsc --noEmit",
    "test": "bun test",
    "verify:update-artifacts": "bun run scripts/verify-update-artifacts.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@devintern/agent-harness": "workspace:*",
    "@devintern/task-trackers": "workspace:*",
    "@devintern/utils": "workspace:*",
    "@getdevintern/pm": "workspace:*",
    "@mdxeditor/editor": "^4.2.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.14.0",
    "posthog-node": "^5.48.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.11.1",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.3.0",
    "vite": "^7.0.0"
  }
}

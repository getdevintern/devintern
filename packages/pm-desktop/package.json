{
  "name": "@devintern/pm-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop app for @devintern/pm \u2014 multi-ticket AI task creation for your tracker.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build && bun run tsc --noEmit",
    "format": "oxfmt \"src/**/*.ts\" \"src/**/*.tsx\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"src/**/*.tsx\"",
    "lint": "oxlint .",
    "typecheck": "bun run tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@devintern/agent-harness": "workspace:*",
    "@devintern/task-trackers": "workspace:*",
    "@getdevintern/pm": "workspace:*",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.0",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.3.0",
    "vite": "^7.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "shadcn": "^4.6.0",
    "tw-animate-css": "^1.4.0"
  }
}

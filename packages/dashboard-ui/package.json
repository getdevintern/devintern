{
  "name": "@devintern/dashboard-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Local observability dashboard UI for @getdevintern/code (served by `devintern dashboard`)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt \"src/**/*.ts\" \"src/**/*.tsx\" \"vite.config.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"src/**/*.tsx\" \"vite.config.ts\"",
    "lint": "oxlint .",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.6.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "1.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.2",
    "vite": "^7.0.0"
  }
}

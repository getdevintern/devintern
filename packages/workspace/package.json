{
  "name": "@devintern/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "echo \"workspace: source-only package\"",
    "format": "oxfmt \"src/**/*.ts\" \"*.test.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"*.test.ts\"",
    "lint": "oxlint .",
    "typecheck": "bun run tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "^5.3.0"
  }
}
